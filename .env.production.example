APP_NAME="Le Roi du Manioc"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://roidumanioc.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roi_manioc_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Invalidation des autres sessions au changement de mot de passe : garder
# AuthenticateSession actif via le middleware 'auth.session' si besoin renforcé.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Les captures de paiement sont stockées sur le disque "local" (storage/app/private),
# jamais exposé au web. Servies uniquement via la route /paiements/{id}/preuve (auth).
QUEUE_CONNECTION=database
# Les e-mails de paiement partent en file d'attente : garder le cron queue:work actif.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.roidumanioc.ci
MAIL_PORT=465
MAIL_USERNAME=noreply@roidumanioc.ci
MAIL_PASSWORD=CHANGE_MOI
MAIL_FROM_ADDRESS="noreply@roidumanioc.ci"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- LWS ---
# Cron unique : * * * * * php /home/xxx/artisan schedule:run
#   -> lance backup:run (03h00) et activitylog:clean (lundi 03h30)
# File d'attente : cron `* * * * * php artisan queue:work --stop-when-empty --max-time=55`
# Sauvegardes : storage/app/backups/ — chemin de mysqldump si absent du PATH :
DB_DUMP_BINARY=mysqldump

# Connexion Google (OAuth2) — laisser vide pour désactiver le bouton
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Vidéos de formation — Bunny Stream (recommandé : URL d'intégration signées, non partageables)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_TOKEN_TTL=14400

# --- Médias de leçon ---
# Disque privé par défaut (storage/app/private) servi par une route gardée.
# ⚠️ LWS mutualisé : la taille est plafonnée par upload_max_filesize / post_max_size du serveur.
#    Créer un .user.ini à la racine /public si besoin :  upload_max_filesize = 128M / post_max_size = 130M
#    Pour de la vraie vidéo à l'échelle : source « bunny » (BUNNY_STREAM_*) ou MEDIA_VIDEO_DISK=s3.
MEDIA_VIDEO_DISK=local
MEDIA_VIDEO_MAX_MB=128
MEDIA_ATTACHMENT_DISK=local
MEDIA_ATTACHMENT_MAX_MB=25
